{
  "name": "frontguard",
  "version": "0.1.0",
  "description": "Static security scanner for frontend code: XSS sinks, leaked secrets, insecure auth patterns, misconfigurations and vulnerable dependencies.",
  "keywords": [
    "security",
    "sast",
    "scanner",
    "frontend",
    "xss",
    "secrets",
    "react",
    "vue",
    "svelte",
    "angular",
    "osv",
    "sarif",
    "cli"
  ],
  "homepage": "https://github.com/juliocarneiro/frontguard#readme",
  "bugs": {
    "url": "https://github.com/juliocarneiro/frontguard/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juliocarneiro/frontguard.git"
  },
  "license": "MIT",
  "author": "Julio Carneiro (https://github.com/juliocarneiro)",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "bin": {
    "frontguard": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check:package": "publint --strict && attw --pack . --profile esm-only",
    "check:unused": "knip",
    "docs:rules": "node scripts/generate-rules-doc.ts",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@babel/parser": "^8.1.0",
    "@babel/traverse": "^8.1.0",
    "@babel/types": "^8.1.0",
    "commander": "^15.1.0",
    "tinyglobby": "^0.2.17",
    "yaml": "^2.9.1",
    "yocto-spinner": "^1.2.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "knip": "^6.44.2",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "tsdown": "^0.23.7",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
